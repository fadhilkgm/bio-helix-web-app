generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memory {
  id        String   @id @default(cuid())
  sessionId String   @db.VarChar(120)
  filename  String
  mimeType  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}
